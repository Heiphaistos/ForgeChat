{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgeChat",
  "version": "3.52.0",
  "identifier": "org.heiphaistos.forgechat",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../client && npm run dev",
    "beforeBuildCommand": "cd ../client && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ForgeChat",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "userAgent": "ForgeChat/3.27.0 (Desktop)",
        "label": "main",
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https://forgechat.heiphaistos.org wss://forgechat.heiphaistos.org; img-src 'self' https://forgechat.heiphaistos.org data: blob: https:; media-src 'self' blob: mediastream: https://forgechat.heiphaistos.org; style-src 'self' 'unsafe-inline' https://forgechat.heiphaistos.org; script-src 'self' 'wasm-unsafe-eval' https://forgechat.heiphaistos.org https://www.youtube.com https://s.ytimg.com; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* https://forgechat.heiphaistos.org wss://forgechat.heiphaistos.org https://api.tenor.com; worker-src 'self' blob:; frame-src https://www.youtube-nocookie.com https://www.youtube.com"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "forgechat"
        ]
      }
    },
    "shell": {
      "open": "^((mailto:\\w+)|(tel:\\w+)|(https?://\\w+)|(ghosthanddesk://(share|connect)\\?)).+"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "SocialNetworking",
    "shortDescription": "Client de chat communautaire auto-hébergé",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "installMode": "both"
      },
      "wix": null,
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/applications/forgechat-compat.desktop": "linux/forgechat-compat.desktop",
          "/usr/share/doc/forgechat/LISEZ-MOI-LINUX.md": "linux/LISEZ-MOI-LINUX.md"
        },
        "depends": [],
        "recommends": [
          "xdg-desktop-portal",
          "xdg-desktop-portal-gtk",
          "libpulse0"
        ]
      },
      "rpm": {
        "files": {
          "/usr/share/applications/forgechat-compat.desktop": "linux/forgechat-compat.desktop",
          "/usr/share/doc/forgechat/LISEZ-MOI-LINUX.md": "linux/LISEZ-MOI-LINUX.md"
        },
        "recommends": [
          "xdg-desktop-portal",
          "xdg-desktop-portal-gtk",
          "pulseaudio-libs"
        ]
      },
      "appimage": {}
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": false
  }
}
