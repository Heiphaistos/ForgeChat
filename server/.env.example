DATABASE_URL=postgres://forgechat:password@localhost:5432/forgechat
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_to_a_very_long_random_secret_key_at_least_64_chars
PORT=8080
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
FRONTEND_URL=http://localhost:5173

# TURN / STUN (WebRTC) — server/src/handlers/voice.rs
# Sans TURN, les appels sont STUN-only : muets derrière un NAT strict, sans alerte.
# TURN_URL est obligatoire pour activer le relais, ex. turn:forgechat.heiphaistos.org:3478
TURN_URL=
# Mode RECOMMANDE — credentials ephemeres (TURN REST API, HMAC-SHA1, TTL 1 h).
# Doit valoir exactement le `static-auth-secret` de /etc/turnserver.conf
# (avec `use-auth-secret` active). Le secret ne quitte jamais le serveur.
TURN_STATIC_AUTH_SECRET=
# Mode de repli — credentials statiques partages. Utilises uniquement si
# TURN_STATIC_AUTH_SECRET est vide. Le secret est alors distribue en clair a
# tout compte authentifie : a eviter en production.
TURN_USERNAME=
TURN_PASSWORD=
