DATABASE_URL=postgres://forgechat:password@localhost:5432/forgechat
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_to_a_very_long_random_secret_key_at_least_64_chars
PORT=8080
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
FRONTEND_URL=http://localhost:5173

# TURN / STUN (WebRTC) — server/src/handlers/voice.rs
# Sans TURN, les appels sont STUN-only : muets derrière un NAT strict, sans alerte.
# TURN_URL est obligatoire pour activer le relais, ex. turn:forgechat.heiphaistos.org:3478
TURN_URL=
# Mode RECOMMANDE — credentials ephemeres (TURN REST API, HMAC-SHA1, TTL 1 h).
# Doit valoir exactement le `static-auth-secret` de /etc/turnserver.conf
# (avec `use-auth-secret` active). Le secret ne quitte jamais le serveur.
TURN_STATIC_AUTH_SECRET=
# Mode de repli — credentials statiques partages. Utilises uniquement si
# TURN_STATIC_AUTH_SECRET est vide. Le secret est alors distribue en clair a
# tout compte authentifie : a eviter en production.
TURN_USERNAME=
TURN_PASSWORD=

# Mise a jour de l'application bureau — server/src/handlers/desktop.rs
# Manifeste publie par desktop/publier-manifeste.sh, servi par
# GET /api/desktop/latest. Absent = aucune release publiee (204, pas d'erreur).
FORGECHAT_DESKTOP_MANIFEST=./desktop-releases/latest.json
# Base d'URL du dossier statique ou sont deposes les artefacts (installeur,
# portable, .deb, .AppImage). Le serveur prefixe avec elle toute url relative
# du manifeste ; une url deja absolue est laissee telle quelle.
FORGECHAT_DESKTOP_BASE_URL=http://localhost:8080/desktop

# Notifications Web Push (VAPID) — server/src/push.rs
# Sans ces trois variables le push est désactivé (le reste fonctionne).
# Générer une paire : docker compose run --rm server ./forgechat generate-vapid-keys
# (ou, depuis server/ : cargo run -- generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact de l'administrateur transmis aux services push (mailto: ou https:)
VAPID_SUBJECT=mailto:admin@example.org

# Notifications push de l'app mobile (Android, via le service push d'Expo) — server/src/mobile_push.rs
# true pour activer. Le texte des messages n'est envoyé qu'aux téléphones qui ont activé l'aperçu.
PUSH_ENABLED=false
# Facultatif : jeton d'accès du compte Expo qui construit l'app (requis si « Enhanced push security » est activé).
EXPO_ACCESS_TOKEN=

# Administration du site (panneau /admin/site, rapports d'erreurs, signalements) — server/src/handlers/site_admin.rs
# Propriétaire du site : seul compte à pouvoir attribuer le rôle « L-Patron », qui ouvre l'administration.
# Le propriétaire détient le rôle d'office ; aucun L-Patron ne peut en nommer un autre.
FORGECHAT_ADMIN_EMAIL=heiphaistos44@gmail.com

# GIF (sélecteur GIF du web et de l'app mobile), via KLIPY — server/src/handlers/gifs.rs
# Clé gratuite : https://partner.klipy.com/api-keys (vide = GIF désactivés). Elle reste sur le serveur.
KLIPY_API_KEY=
# Filtre de contenu : off | low | medium | high (défaut : medium)
KLIPY_CONTENT_FILTER=medium
