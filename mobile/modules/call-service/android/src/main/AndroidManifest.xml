<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Appel / vocal en arrière-plan : Android coupe micro et caméra d'une app sans service au
       premier plan de ce type (Android 11+, obligatoire depuis Android 14). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <!-- Mode « Notifications sans Google » : connexion gardée en arrière-plan (KeepAliveService). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
  <!-- Mise à jour depuis le serveur ForgeChat (UpdateInstaller) : ouvrir l'installeur Android. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <application>
    <service
      android:name="com.forgechat.callservice.CallForegroundService"
      android:exported="false"
      android:foregroundServiceType="microphone|camera" />
    <service
      android:name="com.forgechat.callservice.KeepAliveService"
      android:exported="false"
      android:foregroundServiceType="remoteMessaging" />
    <provider
      android:name="com.forgechat.callservice.UpdateFileProvider"
      android:authorities="${applicationId}.forgechat.updates"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/forgechat_update_paths" />
    </provider>
  </application>
</manifest>
