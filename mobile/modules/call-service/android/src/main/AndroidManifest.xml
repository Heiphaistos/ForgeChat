<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Appel / vocal en arrière-plan : Android coupe micro et caméra d'une app sans service au
       premier plan de ce type (Android 11+, obligatoire depuis Android 14). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <!-- Mode « Notifications sans Google » : connexion gardée en arrière-plan (KeepAliveService). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
  <application>
    <service
      android:name="com.forgechat.callservice.CallForegroundService"
      android:exported="false"
      android:foregroundServiceType="microphone|camera" />
    <service
      android:name="com.forgechat.callservice.KeepAliveService"
      android:exported="false"
      android:foregroundServiceType="remoteMessaging" />
    <!-- Widgets de l'écran d'accueil (ForgeWidgets.kt, src/services/widgets.ts). -->
    <receiver
      android:name="com.forgechat.callservice.MessagesWidget"
      android:exported="false"
      android:label="@string/forge_widget_messages_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/forge_widget_messages" />
    </receiver>
    <receiver
      android:name="com.forgechat.callservice.VoiceWidget"
      android:exported="false"
      android:label="@string/forge_widget_voice_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/forge_widget_voice" />
    </receiver>
  </application>
</manifest>
