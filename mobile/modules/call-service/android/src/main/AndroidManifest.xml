<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Appel / vocal en arrière-plan : Android coupe micro et caméra d'une app sans service au
       premier plan de ce type (Android 11+, obligatoire depuis Android 14). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <!-- Partage d'écran (MediaProjection) : le service au premier plan de type mediaProjection est
       celui de @livekit/react-native-webrtc (MediaProjectionService, déclaré dans son manifeste) ;
       la permission est aussi posée par plugins/withScreenShare.js. CallForegroundService ne prend
       PAS ce type : démarré sans jeton de capture, Android 14 le refuserait (SecurityException). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
  <!-- Mode « Notifications sans Google » : connexion gardée en arrière-plan (KeepAliveService). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
  <application>
    <service
      android:name="com.forgechat.callservice.CallForegroundService"
      android:exported="false"
      android:foregroundServiceType="microphone|camera" />
    <service
      android:name="com.forgechat.callservice.KeepAliveService"
      android:exported="false"
      android:foregroundServiceType="remoteMessaging" />
  </application>
</manifest>
