# Copier en .env.local (non commité) puis adapter.

# URL publique du backend ForgeChat (HTTPS obligatoire hors développement et LAN).
# En local sur émulateur Android : http://10.0.2.2:8080 ; simulateur iOS : http://localhost:8080
# Profil lan : http://<IPv4 privée du PC>:8080 (10.x, 172.16-31.x ou 192.168.x, sinon le build
# échoue). À passer dans l'environnement du build, jamais dans un fichier versionné.
FORGECHAT_API_URL=

# development | lan | preview | production (voir docs/RELEASE.md)
#   development = émulateur + Metro ; lan = téléphone de test sur le réseau local, jamais distribué
#   (HTTP vers cette IP seulement, pas de push) ; preview = « ForgeChat Dev » (dev-apk, pré-prod) ;
#   production = « ForgeChat » (client-apk / Play Store, aucune fonction de dev).
APP_ENV=development
# Même valeur qu'APP_ENV (inlinée à la compilation : retire les outils de dev du client-apk).
# Facultative hors production ; obligatoire et égale à « production » pour le client-apk.
# EXPO_PUBLIC_APP_ENV=development

# Identifiant de projet EAS (npx eas-cli@latest init) — requis pour les notifications push.
EAS_PROJECT_ID=

# L'identifiant d'app n'est plus configurable : org.heiphaistos.forgechat (+ .development, .lan, .dev).
