# Copier en .env.local (non commité) puis adapter.

# URL publique du backend ForgeChat (HTTPS obligatoire hors développement).
# En local sur émulateur Android : http://10.0.2.2:8080 ; simulateur iOS : http://localhost:8080
FORGECHAT_API_URL=https://forgechat.heiphaistos.org

# development | preview | production
APP_ENV=development

# Identifiant de projet EAS (npx eas-cli@latest init) — requis pour les notifications push.
EAS_PROJECT_ID=

# Identifiant d'app (Android package / iOS bundle id).
FORGECHAT_BUNDLE_ID=org.heiphaistos.forgechat
